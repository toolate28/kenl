#   test:
#     steps:
#       - uses: actions/checkout@v5
#       - uses: ./.github/actions/atom-log
#         with:
#           event_type: CI
#           message: "Running tests for commit ${{ github.sha }}"
#       - run: pytest
#       - uses: ./.github/actions/atom-log
#         if: success()
#         with:
#           event_type: TEST
#           message: "All tests passed"
